---
layout: null
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  <url>
    <loc>{{ site.url }}{{ site.baseurl }}/</loc>
    <lastmod>{{ site.time | date_to_xmlschema }}</lastmod>
    <changefreq>daily</changefreq>
    <priority>1.0</priority>
  </url>

  {% assign grouped_pages = site.pages | group_by_exp: "page", "page.url | remove: 'index.html'" %}
  {% capture page_sitemap_urls %}|/|{% endcapture %}
  {% for group in grouped_pages %}
    {% assign page = group.items | first %}
    {% assign sitemap_url = group.name %}
    {% assign is_tag_page = sitemap_url | slice: 0, 6 %}
    {% unless sitemap_url == "/" or sitemap_url == "/404.html" or sitemap_url == "/sitemap.xml" or sitemap_url == "/robots.txt" or sitemap_url contains ".css" or sitemap_url contains ".js" or is_tag_page == "/tags/" %}
      {% capture page_sitemap_urls %}{{ page_sitemap_urls }}{{ sitemap_url }}|{% endcapture %}
  <url>
    <loc>{{ site.url }}{{ site.baseurl }}{{ sitemap_url }}</loc>
    {% if page.last_modified_at %}
    <lastmod>{{ page.last_modified_at | date_to_xmlschema }}</lastmod>
    {% else %}
    <lastmod>{{ site.time | date_to_xmlschema }}</lastmod>
    {% endif %}
    <changefreq>weekly</changefreq>
    <priority>0.8</priority>
  </url>
    {% endunless %}
  {% endfor %}

  {% assign grouped_notes = site.notes | group_by: "url" %}
  {% for group in grouped_notes %}
    {% assign note = group.items | first %}
    {% capture note_url_key %}|{{ group.name }}|{% endcapture %}
    {% unless page_sitemap_urls contains note_url_key %}
  <url>
    <loc>{{ site.url }}{{ site.baseurl }}{{ group.name }}</loc>
    {% if note.last_modified_at %}
    <lastmod>{{ note.last_modified_at | date_to_xmlschema }}</lastmod>
    {% elsif note.date %}
    <lastmod>{{ note.date | date_to_xmlschema }}</lastmod>
    {% else %}
    <lastmod>{{ site.time | date_to_xmlschema }}</lastmod>
    {% endif %}
    <changefreq>monthly</changefreq>
    <priority>0.6</priority>
  </url>
    {% endunless %}
  {% endfor %}
</urlset>
