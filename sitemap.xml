---
layout: null
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  <url>
    <loc>{{ site.url }}{{ site.baseurl }}/</loc>
    <lastmod>{{ site.time | date_to_xmlschema }}</lastmod>
    <changefreq>daily</changefreq>
    <priority>1.0</priority>
  </url>
  {% for page in site.pages %}
  {% assign sitemap_url = page.url | remove: "index.html" %}
  {% assign is_tag_page = sitemap_url | slice: 0, 6 %}
  {% unless page.url == "/" or page.url == "/404.html" or page.url == "/sitemap.xml" or page.url == "/robots.txt" or page.extname == ".css" or page.extname == ".js" or is_tag_page == "/tags/" %}
  <url>
    <loc>{{ site.url }}{{ site.baseurl }}{{ sitemap_url }}</loc>
    {% if page.last_modified_at %}
    <lastmod>{{ page.last_modified_at | date_to_xmlschema }}</lastmod>
    {% else %}
    <lastmod>{{ site.time | date_to_xmlschema }}</lastmod>
    {% endif %}
    <changefreq>weekly</changefreq>
    <priority>0.8</priority>
  </url>
  {% endunless %}
  {% endfor %}
  {% for note in site.notes %}
  <url>
    <loc>{{ site.url }}{{ site.baseurl }}{{ note.url }}</loc>
    {% if note.last_modified_at %}
    <lastmod>{{ note.last_modified_at | date_to_xmlschema }}</lastmod>
    {% elsif note.date %}
    <lastmod>{{ note.date | date_to_xmlschema }}</lastmod>
    {% else %}
    <lastmod>{{ site.time | date_to_xmlschema }}</lastmod>
    {% endif %}
    <changefreq>monthly</changefreq>
    <priority>0.6</priority>
  </url>
  {% endfor %}
</urlset>
